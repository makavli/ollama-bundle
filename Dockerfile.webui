FROM ghcr.io/open-webui/open-webui:main

LABEL description="OpenWebUI container preconfigured for a local Ollama server" \
      org.opencontainers.image.source="https://github.com/makavli/ollama-bundle"

# OpenWebUI reads OLLAMA_BASE_URL to find Ollama. Override at runtime with
#   docker run -e OLLAMA_BASE_URL=http://<host>:11434 ...
ENV OLLAMA_BASE_URL=http://host.docker.internal:11434

EXPOSE 8080

# The base image's own entrypoint/CMD starts OpenWebUI's Python backend,
# so no CMD override here (the previous `node /app/build/index.js` could not start it).
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -fsS http://localhost:8080/health || exit 1
